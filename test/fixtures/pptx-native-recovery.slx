<deck version="1" width="960" height="540">
  <slide id="opacity" background="#FFFFFF">
    <shape id="backdrop" name="rect" x="50" y="60" w="450" h="230" fill="#204060"/>
    <text id="transparent-text" x="80" y="105" w="390" h="55" font-size="32" color="#FFFFFF" opacity="0.5">Editable transparent text</text>
    <shape id="transparent-shape" name="rect" x="80" y="180" w="280" h="75" fill="#E03440" opacity="0.45"/>
  </slide>
  <slide id="path" background="#FFFFFF">
    <line id="loop" x="100" y="100" w="650" h="170" points="650,0 650,170 0,170 0,10" stroke="#455668" stroke-width="2" stroke-dash="dash" curve="round" arrow-end="stealth"/>
  </slide>
  <slide id="labels" background="#FFFFFF">
    <chart id="bars" x="130" y="80" w="650" h="360" font-size="14" title="Editable values">
      <data cols="Category,Value"><row>Before,1.0</row><row>After,55.2</row></data>
      <series type="bar" x="Value" y="Category" fill="#245683" data-labels="value"/>
      <x-axis format="0.0" min="0" max="60"/>
      <y-axis type="category"/>
    </chart>
  </slide>
  <slide id="automatic-table" background="#FFFFFF">
    <table id="auto-rows" x="100" y="100" w="360" h="180">
      <cols>0.5,0.5</cols>
      <tr><td>Short</td><td>Short</td></tr>
      <tr><td>This cell deliberately contains enough words to wrap across several lines in the narrow table column.</td><td>Long row</td></tr>
      <tr><td>Short</td><td>Short</td></tr>
    </table>
  </slide>
</deck>
