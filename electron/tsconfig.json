{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "rootDir": ".",
    "outDir": "../dist-electron",
    "strict": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "types": ["node"],
    "esModuleInterop": true
  },
  "include": ["main.ts"]
}
