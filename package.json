{
  "name": "slidex",
  "version": "0.1.0",
  "description": "SlideX — an XML-based slide language and WYSIWYG editor/viewer for AI-friendly deck authoring, with pixel-true export to PPTX / PNG / PDF.",
  "type": "module",
  "bin": {
    "slidex": "dist/cli.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p app/tsconfig.json",
    "start": "npm run build && node dist/cli.js serve examples/quickstart/deck.slx",
    "app": "npm run build && electron electron/main.js",
    "test": "npm run build && node test/run.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "puppeteer-core": "^23.11.1"
  },
  "keywords": [
    "slides",
    "presentation",
    "xml",
    "dsl",
    "pptx",
    "export",
    "editor"
  ],
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.4.1",
    "typescript": "^7.0.2",
    "@types/node": "^24.13.5"
  }
}
